{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowbird.dev/schemas/diagnostic-event.v1.schema.json",
  "title": "YellowBird diagnostic event",
  "description": "A redacted, ordered event from a YellowBird scout run.",
  "type": "object",
  "required": [
    "schema",
    "sequence",
    "timestamp",
    "level",
    "component",
    "runId",
    "event",
    "message",
    "data"
  ],
  "properties": {
    "schema": { "const": "yellowbird.diagnostic-event.v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "level": { "enum": ["debug", "info", "warn", "error"] },
    "component": { "const": "local-scout" },
    "runId": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "data": { "type": "object" }
  }
}
