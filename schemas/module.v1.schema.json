{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowbird.dev/schemas/module.v1.schema.json",
  "title": "YellowBird reusable browser workflow module",
  "type": "object",
  "required": ["schema", "parameters", "steps"],
  "properties": {
    "schema": { "const": "yellowbird.module.v1" },
    "parameters": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "defaults": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/click" },
          { "$ref": "#/$defs/fill" },
          { "$ref": "#/$defs/select" },
          { "$ref": "#/$defs/check" },
          { "$ref": "#/$defs/uncheck" },
          { "$ref": "#/$defs/hover" },
          { "$ref": "#/$defs/press" },
          { "$ref": "#/$defs/expectText" },
          { "$ref": "#/$defs/expectVisible" },
          { "$ref": "#/$defs/expectValue" },
          { "$ref": "#/$defs/expectVisual" },
          { "$ref": "#/$defs/module" }
        ]
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "type": "string" },
        "selector": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/semanticTarget" }
      },
      "oneOf": [
        { "required": ["selector"] },
        { "required": ["target"] }
      ]
    },
    "semanticTarget": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "alert", "alertdialog", "application", "article", "banner",
            "blockquote", "button", "caption", "cell", "checkbox", "code",
            "columnheader", "combobox", "complementary", "contentinfo",
            "definition", "deletion", "dialog", "directory", "document",
            "emphasis", "feed", "figure", "form", "generic", "grid",
            "gridcell", "group", "heading", "img", "insertion", "link",
            "list", "listbox", "listitem", "log", "main", "marquee", "math",
            "meter", "menu", "menubar", "menuitem", "menuitemcheckbox",
            "menuitemradio", "navigation", "none", "note", "option",
            "paragraph", "presentation", "progressbar", "radio", "radiogroup",
            "region", "row", "rowgroup", "rowheader", "scrollbar", "search",
            "searchbox", "separator", "slider", "spinbutton", "status", "strong",
            "subscript", "superscript", "switch", "tab", "table", "tablist",
            "tabpanel", "term", "textbox", "time", "timer", "toolbar",
            "tooltip", "tree", "treegrid", "treeitem"
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 400 },
        "exact": { "type": "boolean" },
        "heal": { "type": "boolean" }
      }
    },
    "click": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "action": { "const": "click" } } }
      ]
    },
    "fill": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "action": { "const": "fill" },
            "value": { "type": "string" },
            "valueFromEnv": { "type": "string", "minLength": 1 }
          },
          "oneOf": [
            { "required": ["value"] },
            { "required": ["valueFromEnv"] }
          ]
        }
      ]
    },
    "select": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["value"], "properties": { "action": { "const": "select" }, "value": { "type": "string" } } }
      ]
    },
    "check": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "action": { "const": "check" } } }] },
    "uncheck": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "action": { "const": "uncheck" } } }] },
    "hover": { "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "action": { "const": "hover" } } }] },
    "press": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["key"], "properties": { "action": { "const": "press" }, "key": { "type": "string", "minLength": 1, "maxLength": 50 } } }
      ]
    },
    "expectText": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["text"],
          "properties": {
            "action": { "const": "expectText" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "expectVisible": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "action": { "const": "expectVisible" } } }
      ]
    },
    "expectValue": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["value"], "properties": { "action": { "const": "expectValue" }, "value": { "type": "string" } } }
      ]
    },
    "expectVisual": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["baseline"],
          "properties": {
            "action": { "const": "expectVisual" },
            "baseline": { "type": "string", "minLength": 1, "pattern": "^(?![/\\\\])" },
            "maxDiffPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
            "colorThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "required": ["id", "action", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "const": "module" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\])"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
