{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowbird.dev/schemas/scout-evidence.v2.schema.json",
  "title": "YellowBird local scout evidence",
  "description": "Portable evidence emitted by a bounded YellowBird local browser scout.",
  "type": "object",
  "required": [
    "schema",
    "outcome",
    "intent",
    "run",
    "target",
    "assertions",
    "findings",
    "invalidTestMechanics",
    "observations",
    "coverageGaps",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "yellowbird.scout-evidence.v2"
    },
    "outcome": {
      "enum": ["clear", "attention", "inconclusive"]
    },
    "intent": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "run": {
      "type": "object",
      "required": ["id", "startedAt", "durationMs"],
      "properties": {
        "id": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "required": ["url", "origin", "authorization"],
      "properties": {
        "requestedUrl": { "type": "string", "format": "uri" },
        "url": { "type": "string", "format": "uri" },
        "origin": { "type": "string", "format": "uri" },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "field",
              "from",
              "to",
              "rationale",
              "expectedResultChanged"
            ],
            "properties": {
              "code": { "type": "string" },
              "field": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "rationale": { "type": "string" },
              "expectedResultChanged": { "const": false }
            }
          }
        },
        "authorization": {
          "type": "object",
          "required": ["method", "scope", "rationale"],
          "properties": {
            "method": { "type": "string" },
            "scope": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      }
    },
    "assertions": {
      "type": "object",
      "required": [
        "expectedStatus",
        "expectedTitle",
        "expectedTexts",
        "consoleErrorsAllowed"
      ],
      "properties": {
        "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "expectedTitle": { "type": ["string", "null"] },
        "expectedTexts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consoleErrorsAllowed": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "invalidTestMechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "classification",
          "title",
          "evidence",
          "remediation"
        ],
        "properties": {
          "id": { "type": "string" },
          "classification": { "const": "test-mechanics" },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "observations": {
      "type": "object",
      "required": ["browser", "navigation", "workflowSteps"],
      "properties": {
        "browser": {
          "type": "object",
          "required": ["launch"],
          "properties": {
            "launch": {
              "type": "object",
              "required": ["successful", "diagnostic"],
              "properties": {
                "successful": { "type": "boolean" },
                "diagnostic": { "type": ["object", "null"] }
              }
            }
          }
        },
        "navigation": {
          "type": "object",
          "required": ["completed", "status", "reason", "diagnostic"],
          "properties": {
            "completed": { "type": "boolean" },
            "status": { "enum": ["completed", "failed", "skipped"] },
            "reason": { "type": ["string", "null"] },
            "diagnostic": { "type": ["object", "null"] }
          }
        },
        "workflowSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "action", "status", "evidence", "durationMs"],
            "properties": {
              "id": { "type": "string" },
              "action": { "type": "string" },
              "status": { "enum": ["passed", "failed", "invalid", "skipped"] },
              "evidence": { "type": "string" },
              "reason": { "type": "string" },
              "durationMs": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "evidence",
        "report",
        "screenshot",
        "regression",
        "playwrightConfig",
        "replayPackage",
        "diagnostics"
      ],
      "properties": {
        "evidence": { "type": "string" },
        "report": { "type": "string" },
        "screenshot": { "type": ["string", "null"] },
        "regression": { "type": "string" },
        "playwrightConfig": { "type": "string" },
        "diagnostics": { "type": "string" },
        "replayPackage": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["runner", "runtime", "browser", "agenticEngine"],
      "properties": {
        "runner": { "type": "string" },
        "runtime": { "type": "string" },
        "browser": { "type": "string" },
        "agenticEngine": { "type": ["string", "null"] }
      }
    }
  }
}
