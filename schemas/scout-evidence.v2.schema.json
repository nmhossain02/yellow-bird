{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowbird.dev/schemas/scout-evidence.v2.schema.json",
  "title": "YellowBird local scout evidence",
  "description": "Portable evidence emitted by a bounded YellowBird local browser scout.",
  "type": "object",
  "required": [
    "schema",
    "outcome",
    "intent",
    "run",
    "target",
    "assertions",
    "findings",
    "invalidTestMechanics",
    "observations",
    "coverageGaps",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "yellowbird.scout-evidence.v2"
    },
    "outcome": {
      "enum": ["clear", "attention", "inconclusive"]
    },
    "intent": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "run": {
      "type": "object",
      "required": ["id", "startedAt", "durationMs"],
      "properties": {
        "id": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "required": ["url", "origin", "authorization"],
      "properties": {
        "requestedUrl": { "type": "string", "format": "uri" },
        "url": { "type": "string", "format": "uri" },
        "origin": { "type": "string", "format": "uri" },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "field",
              "from",
              "to",
              "rationale",
              "expectedResultChanged"
            ],
            "properties": {
              "code": { "type": "string" },
              "field": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "rationale": { "type": "string" },
              "expectedResultChanged": { "const": false }
            }
          }
        },
        "authorization": {
          "type": "object",
          "required": ["method", "scope", "rationale"],
          "properties": {
            "method": { "type": "string" },
            "scope": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      }
    },
    "assertions": {
      "type": "object",
      "required": [
        "expectedStatus",
        "expectedTitle",
        "expectedTexts",
        "consoleErrorsAllowed"
      ],
      "properties": {
        "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "expectedTitle": { "type": ["string", "null"] },
        "expectedTexts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consoleErrorsAllowed": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "invalidTestMechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "classification",
          "title",
          "evidence",
          "remediation"
        ],
        "properties": {
          "id": { "type": "string" },
          "classification": { "const": "test-mechanics" },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "observations": {
      "type": "object",
      "required": ["browser", "navigation", "workflowSteps"],
      "properties": {
        "browser": {
          "type": "object",
          "required": ["launch"],
          "properties": {
            "launch": {
              "type": "object",
              "required": ["successful", "diagnostic"],
              "properties": {
                "successful": { "type": "boolean" },
                "diagnostic": { "type": ["object", "null"] }
              }
            }
          }
        },
        "navigation": {
          "type": "object",
          "required": ["completed", "status", "reason", "diagnostic"],
          "properties": {
            "completed": { "type": "boolean" },
            "status": { "enum": ["completed", "failed", "skipped"] },
            "reason": { "type": ["string", "null"] },
            "diagnostic": { "type": ["object", "null"] }
          }
        },
        "workflowSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "action", "status", "evidence", "durationMs"],
            "properties": {
              "id": { "type": "string" },
              "action": { "type": "string" },
              "status": { "enum": ["passed", "failed", "invalid", "skipped"] },
              "evidence": { "type": "string" },
              "reason": { "type": "string" },
              "durationMs": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "exploration": {
          "type": "object",
          "required": [
            "requested",
            "mode",
            "status",
            "coverage",
            "summary",
            "steps",
            "pages",
            "verification",
            "engine",
            "capabilities",
            "provenance",
            "issue"
          ],
          "properties": {
            "requested": { "type": "boolean" },
            "mode": {
              "enum": ["agent-safe-interaction", "not-requested"]
            },
            "status": {
              "enum": [
                "pending",
                "not-requested",
                "skipped",
                "inconclusive",
                "completed"
              ]
            },
            "coverage": {
              "enum": [
                "pending",
                "not-requested",
                "covered",
                "partial",
                "blocked"
              ]
            },
            "summary": { "type": "string" },
            "engine": { "type": ["string", "null"] },
            "capabilities": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["jsonSchema", "toolCalls", "imageInput"],
                  "properties": {
                    "jsonSchema": {
                      "enum": ["verified", "unverified", "unavailable"]
                    },
                    "toolCalls": {
                      "enum": ["verified", "unverified", "unavailable"]
                    },
                    "imageInput": {
                      "enum": ["verified", "unverified", "unavailable"]
                    }
                  }
                }
              ]
            },
            "provenance": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "adapter",
                    "endpointClass",
                    "modelRequested",
                    "modelReported",
                    "capabilityManifestVersion"
                  ],
                  "properties": {
                    "adapter": { "type": "string" },
                    "endpointClass": { "enum": ["loopback", "remote"] },
                    "modelRequested": { "type": "string" },
                    "modelReported": { "type": "string" },
                    "capabilityManifestVersion": { "type": "string" }
                  }
                }
              ]
            },
            "issue": { "type": ["object", "null"] },
            "routePolicy": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "primaryRoutes",
                    "navigationRoutes",
                    "loadRoutes"
                  ],
                  "properties": {
                    "primaryRoutes": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "navigationRoutes": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "loadRoutes": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              ]
            },
            "verification": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": [
                    "profile",
                    "authority",
                    "satisfied",
                    "criteria",
                    "summary"
                  ],
                  "properties": {
                    "profile": { "type": "string" },
                    "authority": {
                      "const": "yellowbird-observed-criteria"
                    },
                    "satisfied": { "type": "boolean" },
                    "criteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "satisfied"],
                        "properties": {
                          "id": { "type": "string" },
                          "satisfied": { "type": "boolean" }
                        }
                      }
                    },
                    "summary": { "type": "string" }
                  }
                }
              ]
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["url", "title", "authorizedControlCount"],
                "properties": {
                  "url": { "type": "string" },
                  "title": { "type": "string" },
                  "authorizedControlCount": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "action",
                  "status",
                  "sourceUrl",
                  "requestedUrl",
                  "url",
                  "title",
                  "destinationControlCount",
                  "httpStatus",
                  "evidence",
                  "rationale",
                  "value",
                  "locator",
                  "navigationAttempted",
                  "durationMs"
                ],
                "properties": {
                  "id": { "type": "string" },
                  "action": {
                    "enum": ["visit", "fill", "select", "click"]
                  },
                  "status": {
                    "enum": ["passed", "failed", "invalid"]
                  },
                  "sourceUrl": { "type": "string" },
                  "requestedUrl": { "type": ["string", "null"] },
                  "url": { "type": "string" },
                  "title": { "type": "string" },
                  "destinationControlCount": {
                    "type": ["integer", "null"],
                    "minimum": 0
                  },
                  "httpStatus": { "type": ["integer", "null"] },
                  "evidence": { "type": "string" },
                  "rationale": { "type": "string" },
                  "value": { "type": ["string", "null"] },
                  "navigationAttempted": { "type": "boolean" },
                  "locator": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "selector",
                          "ordinal",
                          "matchCount"
                        ],
                        "properties": {
                          "kind": { "const": "css" },
                          "selector": { "type": "string" },
                          "ordinal": { "type": "integer", "minimum": 0 },
                          "matchCount": { "type": "integer", "minimum": 1 }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "role",
                          "name",
                          "ordinal",
                          "matchCount"
                        ],
                        "properties": {
                          "kind": { "const": "role" },
                          "role": { "type": "string" },
                          "name": { "type": "string" },
                          "ordinal": { "type": "integer", "minimum": 0 },
                          "matchCount": { "type": "integer", "minimum": 1 }
                        }
                      }
                    ]
                  },
                  "durationMs": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "evidence",
        "report",
        "screenshot",
        "regression",
        "playwrightConfig",
        "replayPackage",
        "diagnostics"
      ],
      "properties": {
        "evidence": { "type": "string" },
        "report": { "type": "string" },
        "screenshot": { "type": ["string", "null"] },
        "regression": { "type": "string" },
        "playwrightConfig": { "type": "string" },
        "diagnostics": { "type": "string" },
        "replayPackage": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["runner", "runtime", "browser", "agenticEngine"],
      "properties": {
        "runner": { "type": "string" },
        "runtime": { "type": "string" },
        "browser": { "type": "string" },
        "agenticEngine": { "type": ["string", "null"] },
        "engine": {
          "type": "object",
          "required": [
            "adapter",
            "endpointClass",
            "modelRequested",
            "modelReported",
            "capabilityManifestVersion"
          ],
          "properties": {
            "adapter": { "type": "string" },
            "endpointClass": { "enum": ["loopback", "remote"] },
            "modelRequested": { "type": "string" },
            "modelReported": { "type": "string" },
            "capabilityManifestVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
