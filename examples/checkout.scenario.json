{
  "schema": "yellowbird.scenario.v1",
  "target": "http://127.0.0.1:4321/?fixed",
  "intent": "A shopper can provide an email and prepare an order",
  "permissions": [
    "browser.navigate",
    "browser.read",
    "browser.fill",
    "browser.click"
  ],
  "variables": {
    "TEST_EMAIL": "bird@example.test"
  },
  "assertions": {
    "expectedStatus": 200,
    "expectedTitle": "Feather Shop",
    "expectedTexts": ["Checkout ready"]
  },
  "steps": [
    {
      "id": "prepare-order",
      "action": "module",
      "path": "modules/prepare-order.module.json",
      "inputs": {
        "EMAIL": "{{ vars.TEST_EMAIL }}"
      }
    }
  ]
}
