{
  "name": "yellow-bird",
  "version": "0.5.0-alpha",
  "bin": {
    "yellowbird": "./bin/yellowbird.js"
  },
  "description": "Open-source, deploy-anywhere canary testing with portable evidence",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.9",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.js",
    "start": "bun src/server.js",
    "doctor": "bun bin/yellowbird.js doctor",
    "scout": "bun bin/yellowbird.js scout",
    "demo:target": "bun examples/demo-target.js",
    "setup:browsers": "bunx playwright install chromium",
    "test": "bun test --timeout 15000 test/*.test.js",
    "test:price-scout": "bun scripts/validate-price-scout-e2e.js",
    "check": "bun test --timeout 15000 test/*.test.js"
  },
  "type": "module",
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
